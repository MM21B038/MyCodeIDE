  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "desktop-src",
    "outDir": "desktop-dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "desktop-src/**/*.ts"
  ]
}
